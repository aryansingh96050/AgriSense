# AgriSense Configuration
APP_NAME=AgriSense
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration (SQLite default, PostgreSQL supported for production)
DATABASE_URL=sqlite:///./agrisense.db
# For Production on Render/Railway/Supabase:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Irrigation Safety Thresholds
MAX_CONTINUOUS_PUMP_MINUTES=45
DEFAULT_SOIL_MOISTURE_TARGET=65.0
DEFAULT_WILTING_POINT=30.0

# Open-Meteo Weather Simulation / Location (Latitude & Longitude)
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090
USE_REAL_WEATHER_API=False
